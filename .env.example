# Wavonyx configuration. Copy to .env and adjust. All variables are optional;
# the defaults shown make a working local server on :9900 with no auth and
# webhooks disabled.

# --- server ---
# Listen address.
WAVONYX_ADDR=:9900
# Require this key via the X-API-Key header on every endpoint except /health.
# Leave empty to disable auth. Generate one with: openssl rand -hex 32
WAVONYX_API_KEY=
# Directory for the SQLite database (WhatsApp credentials + session registry).
# Must persist across restarts, or every deploy forces re-pairing.
WAVONYX_DATA_DIR=./data
# Name shown in WhatsApp > Linked Devices for this connection (set at pairing).
WAVONYX_DEVICE_NAME=Wavonyx
# Note: Wavonyx automatically marks a chat as read (blue ticks) just before
# replying to it, mirroring human behavior. This is not configurable.

# --- webhooks (inbound messages) ---
# Global endpoint messages are POSTed to. Empty disables delivery (the in-memory
# ring buffer at GET /sessions/{id}/messages still works). A per-session
# webhook_url overrides this.
WAVONYX_WEBHOOK_URL=
# HMAC-SHA256 key for the X-Wavonyx-Signature header. Empty = unsigned.
# Generate one with: openssl rand -hex 32
WAVONYX_WEBHOOK_SECRET=
WAVONYX_WEBHOOK_TIMEOUT=10s
WAVONYX_WEBHOOK_RETRIES=5
# 1 keeps delivery strictly ordered; higher trades ordering for throughput.
WAVONYX_WEBHOOK_WORKERS=1
# Deliver messages authored on the linked phone / other own devices.
WAVONYX_WEBHOOK_INCLUDE_FROM_ME=false

# --- simulated typing (anti-ban) ---
# off | constant | natural
WAVONYX_TYPING_MODE=natural
# constant mode: delay per character.
WAVONYX_TYPING_PER_CHAR=55ms
# natural mode: typing speed range (characters per second).
WAVONYX_TYPING_MIN_CPS=4
WAVONYX_TYPING_MAX_CPS=9
# Clamp the total typing delay. MAX_TOTAL is the hard stall guard.
WAVONYX_TYPING_MIN_TOTAL=400ms
WAVONYX_TYPING_MAX_TOTAL=15s

# --- sending / buffering ---
# Minimum pause between two sends on the same session.
WAVONYX_SEND_MIN_GAP=1s
# Per-session outbound queue depth; a send past this fails with 429 queue_full.
WAVONYX_SEND_QUEUE=100
# Per-session inbound ring-buffer capacity.
WAVONYX_RING_SIZE=200

# debug | info | warn | error
WAVONYX_LOG_LEVEL=info
